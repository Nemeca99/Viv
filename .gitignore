datasets/
# Root model packs only; use trailing-/* so uml_bigram can be re-included.
/models/*
!/models/uml_bigram_part3/
!/models/uml_bigram_part3/**
/checkpoints/

# Machine indexes and generated runtime evidence that are too large for Git
artifacts/file_index/
artifacts/auto/
foundation/artifacts/auto/knowledge/*.sqlite
foundation/artifacts/rid/*.jsonl
foundation/artifacts/auto/

# Additional generated runtime state
sandbox/work/
sandbox/training_staging/
foundation/sandbox/
foundation/artifacts/carma/
foundation/artifacts/rid/
foundation/artifacts/carma/live/
foundation/artifacts/carma/heartbeat.jsonl
foundation/artifacts/audit/*events.jsonl
foundation/artifacts/audit/security_training_ledger_recovery/
foundation/triad_boundary_registry.bak_*.json

# Keep the active task pointer under version control for cross-session work.
!foundation/artifacts/auto/
foundation/artifacts/auto/*
!foundation/artifacts/auto/agentic/
foundation/artifacts/auto/agentic/*
!foundation/artifacts/auto/agentic/CURRENT_TASK.json

# Generated logs, temporary files, and dumps
*.log
*.out
*.err
*.tmp
*.bak
*.dmp
*.prof
*.pyc
*.CSV
Thumbs.db
desktop.ini

# Keep governed source documentation and receipts trackable. Generated files
# are ignored only when they use conventional cache/temp names above.

# Isolated Part 3 model source remains trackable via /models/* exceptions above.
models/uml_bigram_part3/__pycache__/
models/uml_bigram_part3/artifacts/run_500_steps/tensor_dataset/**/*.pt

# Massive local weight / HF / run packs — never track
foundation/models/gpu/
foundation/artifacts/models/
foundation/models/Training/backups/
foundation/models/Training/current/viv_slm/model/artifacts_local/
foundation/models/Training/current/viv_slm/model/test_training/runs/
foundation/models/Training/current/viv_slm/model/test_training/data/
foundation/models/Training/current/viv_slm/model/test_training/checkpoints/
foundation/models/Training/current/viv_slm/model/test_training/dataset/**/*.pt
foundation/models/Training/current/viv_slm/model/test_training/**/__pycache__/
# Training data corpuses are local; keep only tiny indexes/READMEs if present
foundation/models/Training/data/**
!foundation/models/Training/data/
!foundation/models/Training/data/**/README.md
!foundation/models/Training/data/**/INDEX.json
!foundation/models/Training/data/knowledge/
!foundation/models/Training/data/knowledge/README.md
!foundation/models/Training/data/knowledge/INDEX.json

# Viv-SLM Training control plane: keep declarative source, indexes, manifests,
# and small audit documents trackable while excluding generated runs/tensors.
foundation/models/Training/runs/
foundation/models/Training/checkpoints/**/*.pt
foundation/models/Training/checkpoints/**/*.pth
!foundation/models/Training/checkpoints/
!foundation/models/Training/checkpoints/INDEX.json
foundation/models/Training/evidence/*
!foundation/models/Training/evidence/
!foundation/models/Training/evidence/INDEX.json
# Timestamped small evidence snapshots (JSON/MD manifests + compact reports).
# Keep these trackable for backup; exclude weight tensors and huge run dumps.
!foundation/models/Training/evidence/snapshots/
foundation/models/Training/evidence/snapshots/**
!foundation/models/Training/evidence/snapshots/*/
!foundation/models/Training/evidence/snapshots/*/MANIFEST.json
!foundation/models/Training/evidence/snapshots/*/README.md
!foundation/models/Training/evidence/snapshots/*/reports/
!foundation/models/Training/evidence/snapshots/*/reports/**
foundation/models/Training/evidence/snapshots/**/*.pt
foundation/models/Training/evidence/snapshots/**/*.pth
foundation/models/Training/evidence/snapshots/**/*.bin
foundation/models/Training/evidence/snapshots/**/*.safetensors

# Keep compact identity/tag architecture pilot reports under auto/ trackable.
# Full speak-cheap census rows remain ignored via runs/; store aggregates in snapshots.
!foundation/artifacts/auto/identity_uml_bridge_shadow_v1/
foundation/artifacts/auto/identity_uml_bridge_shadow_v1/**
!foundation/artifacts/auto/identity_uml_bridge_shadow_v1/*/
!foundation/artifacts/auto/identity_uml_bridge_shadow_v1/*/*.json
!foundation/artifacts/auto/identity_uml_bridge_shadow_v1/*/*.md
!foundation/artifacts/auto/tag_architecture_ab_v1/
foundation/artifacts/auto/tag_architecture_ab_v1/**
!foundation/artifacts/auto/tag_architecture_ab_v1/*/
!foundation/artifacts/auto/tag_architecture_ab_v1/*/*.json
!foundation/artifacts/auto/tag_architecture_ab_v1/*/*.md
foundation/models/Training/current/viv_slm/**/__pycache__/
foundation/models/Training/legacy/viv_slm/**/__pycache__/
