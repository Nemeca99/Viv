*.py[cod]
*.pyd
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Local environments and tooling
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example
.cursor/
.vscode/
*.code-workspace

# Secrets, credentials, and local state
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
local_config.*

# Rust
target/
Cargo.lock

# Large external inputs and model material
*.gguf
*.ggml
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.parquet
*.arrow
*.sqlite
*.db
*.db-*
datasets/
models/
