*.py[cod]
*.pyd
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Local environments and tooling
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example
.cursor/
.vscode/
*.code-workspace

