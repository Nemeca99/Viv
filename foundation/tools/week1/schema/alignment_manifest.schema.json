{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "week1/alignment_manifest.schema.json",
  "title": "Week1 Alignment Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "created_by",
    "utterances"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "week1.v1"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "utterances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "utterance_id",
          "audio_path",
          "start_ms",
          "end_ms",
          "label",
          "confidence",
          "transcript",
          "alignment_engine",
          "sequence_idx"
        ],
        "properties": {
          "utterance_id": {
            "type": "string",
            "minLength": 1
          },
          "audio_path": {
            "type": "string",
            "minLength": 1
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string",
            "enum": [
              "vowel-heavy",
              "consonant-heavy"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "transcript": {
            "type": "string",
            "minLength": 1
          },
          "alignment_engine": {
            "type": "string",
            "const": "week1-local-rule"
          },
          "sequence_idx": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
